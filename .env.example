# ============================================
# MediaTracker - Environment Variables
# ============================================
# Bu dosyayı .env.local olarak kopyalayın ve değerleri doldurun.
# .env.local GitHub'a yüklenmez (.gitignore tarafından korunur).

# ---- Supabase (opsiyonel — yoksa uygulama yerel modda çalışır) ----
# Supabase Project Settings → API sayfasından alınabilir.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Cloud Media rollout (public client contract; secret değildir) ----
# Local D2B.1 kullanımı için stage=d2b1 ve V2=true kullanılabilir.
# D2C.1 production cutover D8 release aşamasında kontrollü olarak yapılacaktır.
NEXT_PUBLIC_CLOUD_MEDIA_SCHEMA_STAGE=legacy
NEXT_PUBLIC_CLOUD_MEDIA_V2_ENABLED=false
NEXT_PUBLIC_CLOUD_GOALS_SCHEMA_STAGE=absent
NEXT_PUBLIC_CLOUD_GOALS_V1_ENABLED=false
NEXT_PUBLIC_CLOUD_MEDIA_MAINTENANCE=false
NEXT_PUBLIC_CLOUD_MEDIA_DEPLOYMENT_EPOCH=
NEXT_PUBLIC_CLOUD_MEDIA_MINIMUM_CLIENT_VERSION=

# Persistent embedding cache için opsiyoneldir; yoksa cache hata vermeden kapanır.
# Ana offline-first uygulama ve bellek içi embedding cache bu anahtara ihtiyaç duymaz.
# UYARI: Yalnızca server-side kullanın; NEXT_PUBLIC_ prefix'i vermeyin, loglamayın
# ve gerçek anahtarı Git'e göndermeyin. Service role key RLS'i bypass eder.
SUPABASE_SERVICE_ROLE_KEY=

# ---- TMDB (opsiyonel — film araması için) ----
# https://www.themoviedb.org/settings/api adresinden alınabilir.
TMDB_READ_ACCESS_TOKEN=

# ---- OMDb (opsiyonel — film fallback/detay için) ----
OMDB_API_KEY=

# ---- AI recommendation providers (opsiyonel) ----
# Varsayılan mock provider'dır. Gerçek provider için AI_PROVIDER ve ilgili key'i doldurun.
# Server-funded erişim unset/unknown durumda disabled olur. Production başlangıç önerisi admin_only.
AI_SERVER_ACCESS_MODE=disabled
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# OpenRouter HTTP-Referer header'ı ve server-side source API çağrıları için opsiyonel.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Open Library/TVMaze gibi düzenli server-side provider çağrılarında ürün/sürüm ve contact içermeli.
# Örnek: MediaTracker/0.1 (https://example.invalid; contact@example.invalid)
MEDIA_TRACKER_PROVIDER_USER_AGENT=

# ---- Embedding / ML service (opsiyonel) ----
# Python FastAPI servisi çalışıyorsa gerçek embedding skoru için kullanılır.
MEDIA_TRACKER_ML_SERVICE_URL=http://127.0.0.1:8001
MEDIA_TRACKER_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# "off" verilirse ilgili cache kapatılır.
MEDIA_TRACKER_EMBEDDING_CACHE=
MEDIA_TRACKER_PERSISTENT_EMBEDDING_CACHE=

# ---- D7 annotation tool (yalnız local development) ----
# NODE_ENV=production iken her durumda 404 verir. Flag yalnız server-side okunur.
D7_ANNOTATION_TOOL_ENABLED=0
# Opsiyonel; varsayılan private/recommendation-ml. Public veya paylaşılan yol kullanmayın.
D7_ANNOTATION_DATA_DIR=private/recommendation-ml

# ---- D7-R2A Wikimedia research (server-only, production recommendation'a bağlı değil) ----
# Adapter varsayılan fail-closed kapalıdır. NEXT_PUBLIC_ prefix'i kullanmayın.
MEDIA_TRACKER_WIKIMEDIA_RESEARCH_ENABLED=0
# Anlamlı ürün/sürüm ve contact içermeli. Örnek:
# MediaTracker/0.1 (https://example.invalid/mediatracker; contact@example.invalid)
MEDIA_TRACKER_RESEARCH_USER_AGENT=
# Yalnız conditional Wikimedia integration testi; production feature flag değildir.
D7_RESEARCH_LIVE_SMOKE=0

# ---- D7-R2B OpenAI web source discovery (server-only, production route'a bağlı değil) ----
# Adapter varsayılan fail-closed kapalıdır; yalnız allowlisted real source URL keşfeder.
D7_OPENAI_WEB_DISCOVERY_ENABLED=0
# Tercih edilen explicit web-search-capable model. Boşsa explicit OPENAI_MODEL fallback'i denenir.
OPENAI_RESEARCH_MODEL=
# Yalnız ücretli conditional OpenAI integration testi; normal test suite bunu açmaz.
D7_OPENAI_WEB_DISCOVERY_LIVE_SMOKE=0

# ---- D7-R2C provider-neutral web discovery (server-only, production route'a bağlı değil) ----
# Unset/disabled fail-closed'dur. auto yalnız ayrı ayrı explicit enabled+configured adapter'ları dener.
D7_RESEARCH_DISCOVERY_PROVIDER=disabled
D7_GROQ_WEB_DISCOVERY_ENABLED=0
GROQ_RESEARCH_MODEL=
D7_GROQ_WEB_DISCOVERY_LIVE_SMOKE=0
D7_OPENROUTER_WEB_DISCOVERY_ENABLED=0
OPENROUTER_RESEARCH_MODEL=
D7_OPENROUTER_WEB_DISCOVERY_LIVE_SMOKE=0

# ---- D7-R3B grounded extraction (server-only, production route'a bağlı değil) ----
# Unset/disabled fail-closed'dur. Key ve code-controlled explicit model olmadan provider açılmaz.
D7_RESEARCH_EXTRACTION_PROVIDER=disabled
D7_GROQ_GROUNDED_EXTRACTION_ENABLED=0
D7_GROQ_GROUNDED_EXTRACTION_LIVE_SMOKE=0
GROQ_RESEARCH_EXTRACTION_MODEL=
D7_OPENAI_GROUNDED_EXTRACTION_ENABLED=0
D7_OPENAI_GROUNDED_EXTRACTION_LIVE_SMOKE=0
OPENAI_RESEARCH_EXTRACTION_MODEL=
D7_OPENROUTER_GROUNDED_EXTRACTION_ENABLED=0
D7_OPENROUTER_GROUNDED_EXTRACTION_LIVE_SMOKE=0
OPENROUTER_RESEARCH_EXTRACTION_MODEL=

# ---- D7-R4A grounded research shadow (server-only, public sonucu değiştirmez) ----
# disabled | shadow | active; unset/çelişkili kombinasyonlar fail-closed disabled olur.
# Production başlangıç önerisi: disabled.
D7_RESEARCH_ROLLOUT_MODE=disabled
# Kapalıyken planner/provider/network çağrısı yapılmaz. NEXT_PUBLIC_ prefix'i kullanmayın.
D7_RESEARCH_SHADOW_ENABLED=0
# Active research sonucu ancak revision-bound public-safe kaynak özeti üretilebiliyorsa etkili olur. Server-only.
D7_RESEARCH_PUBLIC_CITATIONS_ENABLED=0
# Server-only bounded process cache; public response/ranking'i değiştirmez.
D7_RESEARCH_EVIDENCE_CACHE_ENABLED=0
# Yalnız R4B conditional shadow integration testi; normal suite network açmaz.
D7_R4_SHADOW_LIVE_SMOKE=0
# Yalnız R5A bounded evidence-gap acceptance; normal suite network açmaz.
D7_R5A_EVIDENCE_GAP_LIVE_SMOKE=0
# Yalnız R5B three-run stability ve bounded Wikimedia coverage audit'i; normal suite network açmaz.
D7_R5B_STABILITY_LIVE_SMOKE=0
# Yalnız R5B.1 compacted extraction stability; normal suite network açmaz.
D7_R5B1_EXTRACTION_STABILITY_LIVE_SMOKE=0
D7_R5B2_DOCUMENT_LIVE_SMOKE=0
# Yalnız R5C aynı-process miss -> hit cache kabulü; normal suite network açmaz.
D7_R5C_CACHE_LIVE_SMOKE=0
# Yalnız D7 final active end-to-end kabulü; normal suite network açmaz.
D7_R6_FINAL_LIVE_SMOKE=0

# ---- D8 staging cutover (yalnız local/server operasyonu) ----
# Üç güvenlik kapısı birlikte explicit değilse staging scriptleri DB'ye bağlanmaz.
D8_STAGING_CUTOVER_ENABLED=0
D8_STAGING_MIGRATION_ALLOWED=0
D8_STAGING_PROJECT_REF=
D8_PRODUCTION_PROJECT_REF=
# Secret bağlantı değeri; loglamayın ve tracked dosyaya gerçek değer yazmayın.
D8_STAGING_DATABASE_URL=
